{
  "$schema": "backend/node_modules/wrangler/config-schema.json",
  "name": "metcue-worker",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/c/*",
      "/health"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "metcue09",
    "FIREBASE_API_KEY": "AIzaSyBEcRA7IsRayBe6PwkLxXxLqOeaDgWa20U",
    "CUE_MODEL": "@cf/meta/llama-3.2-3b-instruct"
  },
  "d1_databases": [
    {
      "binding": "metcue_db",
      "database_name": "metcue-db",
      "database_id": "b0d778df-0465-47e2-8fd5-e9737597f6b7",
      "migrations_dir": "backend/migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "metcue-index"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "metcue-photos"
    }
  ],
  "routes": [
    {
      "pattern": "acquenta.aurunex.com",
      "custom_domain": true
    }
  ]
}
